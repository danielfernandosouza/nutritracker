// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  profile       Profile?
  meals         Meal[]
  weightEntries WeightEntry[]
  workoutLogs   WorkoutLog[]
  authenticators Authenticator[]
  waterEntries  WaterEntry[]
  sleepEntries  SleepEntry[]
  exerciseSetLogs ExerciseSetLog[]
}

model Authenticator {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID         String   @unique
  credentialPublicKey  Bytes
  counter              Int
  transports           String?
  label                String?
  createdAt            DateTime @default(now())

  @@index([userId])
}

model Meal {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  name      String
  calories  Float
  protein   Float
  carbs     Float
  fat       Float
  sodium    Float
  sugar     Float    @default(0)
  emoji     String   @default("🍽️")
  photo     String?
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model Profile {
  id                   String   @id
  user                 User     @relation(fields: [id], references: [id], onDelete: Cascade)
  name                 String?
  sex                  String
  age                  Int
  heightCm             Float
  weightKg             Float
  activityLevel        String
  goal                 String
  exerciseNotes        String?
  mealsPerDay          Int?
  daysPerWeek          Int?
  splitStyle           String?
  equipmentPreference  String?
  favoriteMuscleGroups String[] @default([])
  restWeekdays         Int[]    @default([])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model WeightEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  weightKg  Float
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model WaterEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  amountMl  Int
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model SleepEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  bedTime   String
  wakeTime  String
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model WorkoutLog {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            String
  workoutName     String
  planDayId       String?
  durationMinutes Float?
  caloriesBurned  Float?
  photo           String?
  createdAt       DateTime @default(now())

  @@index([userId, date])
}

model ExerciseSetLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         String
  exerciseId   String
  exerciseName String
  setNumber    Int
  weightKg     Float?
  reps         Int?
  createdAt    DateTime @default(now())

  @@index([userId, exerciseId, date])
  @@index([userId, date])
}
