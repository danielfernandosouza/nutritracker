# Connection string do banco Postgres (Neon: painel do projeto > Connect)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Chave de API da Anthropic (console.anthropic.com) - separada do plano Claude Pro
ANTHROPIC_API_KEY="sk-ant-..."

# Segredo usado pelo Auth.js para assinar os cookies de sessão. Gere com: npx auth secret
AUTH_SECRET="..."

# Código que precisa ser informado no cadastro para criar uma conta nova
SIGNUP_INVITE_CODE="..."
